# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Every value here is OPTIONAL: with none of
# them set the site builds, runs and accepts leads (they are logged server-side
# instead of forwarded). Nothing third-party is loaded until you add an id.
# ---------------------------------------------------------------------------

# Canonical URL of this site. Used for canonical tags, og:url, sitemap, JSON-LD.
# Falls back to site.url in dealer-config.json.
NEXT_PUBLIC_SITE_URL=

# GoHighLevel inbound webhook for the test-drive form. Server-side only — the
# URL never reaches the browser. Leads are logged and still confirmed to the
# visitor when this is empty.
# e.g. https://services.leadconnectorhq.com/hooks/<locationId>/webhook-trigger/<id>
GHL_LEAD_WEBHOOK_URL=

# GoHighLevel chat widget id. The widget script is only injected when set.
NEXT_PUBLIC_GHL_WIDGET_ID=

# Google Tag Manager container, e.g. GTM-ABC1234. Only injected when set.
# Do not add GA/gtag alongside it — tags belong inside the container.
NEXT_PUBLIC_GTM_ID=
